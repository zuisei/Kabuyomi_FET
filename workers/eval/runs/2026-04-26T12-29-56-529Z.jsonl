hives/edgar/data/1045810/000104581026000021/nvda-20260125.htm"}],"responsePath":"gemini","modelName":"gemma-4-31b-it","fallbackReason":null,"promptTokenCount":null,"sourceCount":3,"latencyMs":5503,"creditsCharged":2,"creditsRemaining":194,"creditBillingEnabled":true,"usageCredits":{"monthlyRemaining":0,"monthlyLimit":30,"purchasedRemaining":194,"totalRemaining":194,"resetsAt":"2026-05-01T00:00:00+09:00"},"answerRating":5,"failureLabelsObserved":["good"],"notes":"売上増とCompute & Networking/AI要因を具体的に説明できている。"}
{"evalSetVersion":"chat-quality-v1","runId":"2026-04-26T12-29-56-529Z","evalMode":"pilot","runStartedAt":"2026-04-26T12:29:56.531Z","rowStartedAt":"2026-04-26T12:30:29.635Z","baseURL":"https://kabuyomi-api.dznqjmctk7.workers.dev","deviceKey":"eval-chat-quality-v1","appVersion":"dea51eb","ticker":"NVDA","filingKey":"v6:0001045810:000104581026000021","questionId":"NVDA-06","question":"リスク要因を3つ挙げて","intent":"risk_factors","expectedFocus":["供給制約","輸出規制","需要集中または競争"],"answer":"NVIDIAの主要なリスクとして、顧客集中、在庫リスク、および地政学的リスクが挙げられます。まず、特定の顧客への依存度が高く、2026年度の売上高の22%と14%をそれぞれ1つの顧客が占めており、これが売上への影響を及ぼす可能性があります。\n\nまた、在庫リスクについては、2026年度第1四半期にH20の過剰在庫と購入義務に関連して45億ドルの費用が発生しており、すでに数字に影響が出ています。さらに、米国外の顧客への売上比率が2025年度の41%から2026年度の31%へと低下しており、地政学的な要因による影響が懸念されます。","sources":[{"sourceId":"CTX1","sourceKind":"sec_filing","sourceStrength":"filing_primary","sectionType":"md_a","sourceLabel":"10-K Risk factors context, filed 2026-02-25","excerpt":"Year Ended Jan 25, 2026 Jan 26, 2025 Revenue 100.0 % 100.0 % Cost of revenue 28.9 25.0 Gross profit 71.1 75.0 Operating expenses Research and development 8.6 9.9 Sales, general and administrative 2.1 2.7 Total operating ","sourceUrl":"https://www.sec.gov/Archives/edgar/data/1045810/000104581026000021/nvda-20260125.htm"},{"sourceId":"CTX2","sourceKind":"sec_filing","sourceStrength":"filing_primary","sectionType":"md_a","sourceLabel":"10-K Risk factors context, filed 2026-02-25","excerpt":"Certain direct customers may use either internal resources or third-party system integrators to complete their build. We refer to indirect customers as those who purchase products through our direct customers; indirect c","sourceUrl":"https://www.sec.gov/Archives/edgar/data/1045810/000104581026000021/nvda-20260125.htm"},{"sourceId":"CTX3","sourceKind":"sec_filing","sourceStrength":"filing_primary","sectionType":"md_a","sourceLabel":"10-K Risk factors context, filed 2026-02-25","excerpt":"We estimate that one AI research and deployment company contributed to a meaningful amount of our revenue purchasing cloud services from our customers in fiscal year 2026. Revenue by geographic region is designated based","sourceUrl":"https://www.sec.gov/Archives/edgar/data/1045810/000104581026000021/nvda-20260125.htm"}],"responsePath":"gemini","modelName":"gemma-4-31b-it","fallbackReason":null,"promptTokenCount":null,"sourceCount":3,"latencyMs":6016,"creditsCharged":2,"creditsRemaining":192,"creditBillingEnabled":true,"usageCredits":{"monthlyRemaining":0,"monthlyLimit":30,"purchasedRemaining":192,"totalRemaining":192,"resetsAt":"2026-05-01T00:00:00+09:00"},"answerRating":4,"failureLabelsObserved":["good"],"notes":"顧客集中/在庫/地政学を具体的に挙げられている。source excerptはやや粗い。"}
{"evalSetVersion":"chat-quality-v1","runId":"2026-04-26T12-29-56-529Z","evalMode":"pilot","runStartedAt":"2026-04-26T12:29:56.531Z","rowStartedAt":"2026-04-26T12:30:35.651Z","baseURL":"https://kabuyomi-api.dznqjmctk7.workers.dev","deviceKey":"eval-chat-quality-v1","appVersion":"dea51eb","ticker":"GOOGL","filingKey":"v6:0001652044:000165204426000018","questionId":"GOOGL-06","question":"リスク要因を3つ挙げて","intent":"risk_factors","expectedFocus":["広告市場","規制/訴訟","AI競争"],"answer":"Alphabet Inc.の主要なリスク要因として、競争の激化、広告収入への依存、および規制や独占禁止法への対応が挙げられます。これらは、市場シェアの低下や収入の減少、あるいは法的な制約による事業運営への影響を及ぼす可能性があります。\n\nこれらのリスクは、提供された資料のカテゴリー分けに基づいたものであり、現時点で具体的な数値として業績に影響しているかは確認できません。","sources":[{"sourceId":"S8","sourceKind":"sec_filing","sourceStrength":"filing_primary","sectionType":"md_a","sourceLabel":"10-K Item 7, filed 2026-02-05","excerpt":"We do not intend our use or display of other companies' trade names or trademarks to imply an endorsement or sponsorship of us by such companies, or any relationship with any of these companies. PART I ITEM 1. BUSINESS O","sourceUrl":"https://www.sec.gov/Archives/edgar/data/1652044/000165204426000018/goog-20251231.htm"}],"responsePath":"gemini","modelName":"gemma-4-31b-it","fallbackReason":null,"promptTokenCount":null,"sourceCount":1,"latencyMs":4183,"creditsCharged":2,"creditsRemaining":190,"creditBillingEnabled":true,"usageCredits":{"monthlyRemaining":0,"monthlyLimit":30,"purchasedRemaining":190,"totalRemaining":190,"resetsAt":"2026-05-01T00:00:00+09:00"},"answerRating":4,"failureLabelsObserved":["good"],"notes":"リスク要因3点を具体化できている。"}
{"evalSetVersion":"chat-quality-v1","runId":"2026-04-26T12-29-56-529Z","evalMode":"pilot","runStartedAt":"2026-04-26T12:29:56.531Z","rowStartedAt":"2026-04-26T12:30:39.834Z","baseURL":"https://kabuyomi-api.dznqjmctk7.workers.dev","deviceKey":"eval-chat-quality-v1","appVersion":"dea51eb","ticker":"GOOGL","filingKey":"v6:0001652044:000165204426000018","questionId":"GOOGL-07","question":"成長リスクは？","intent":"risk_factors","expectedFocus":["AI検索変化","広告需要","規制"],"answer":"Alphabet Inc.の成長リスクとして、競争激化、広告収入への依存、規制や独占禁止法への対応、プライバシーとデータ保護、AIなどの技術転換、そしてコンテンツプラットフォームの運営に伴うリスクが挙げられます。これらは、サービスの利用者が減少したり、法的な制裁金が発生したりすることで、収益力や成長速度に悪影響を及ぼす可能性があります。\n\n根拠として、これらの項目がリスク要因として特定されています。現時点で、これらのリスクが具体的な数値として業績にどの程度影響したかは、提供された資料の中では確認できません。","sources":[{"sourceId":"S8","sourceKind":"sec_filing","sourceStrength":"filing_primary","sectionType":"md_a","sourceLabel":"10-K Item 7, filed 2026-02-05","excerpt":"We do not intend our use or display of other companies' trade names or trademarks to imply an endorsement or sponsorship of us by such companies, or any relationship with any of these companies. PART I ITEM 1. BUSINESS O","sourceUrl":"https://www.sec.gov/Archives/edgar/data/1652044/000165204426000018/goog-20251231.htm"}],"responsePath":"gemini","modelName":"gemma-4-31b-it","fallbackReason":null,"promptTokenCount":null,"sourceCount":1,"latencyMs":4816,"creditsCharged":2,"creditsRemaining":188,"creditBillingEnabled":true,"usageCredits":{"monthlyRemaining":0,"monthlyLimit":30,"purchasedRemaining":188,"totalRemaining":188,"resetsAt":"2026-05-01T00:00:00+09:00"},"answerRating":4,"failureLabelsObserved":["good"],"notes":"成長リスクとして競争/広告依存/規制/AI等を説明できている。"}
