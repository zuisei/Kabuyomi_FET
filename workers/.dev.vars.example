# Local model override is optional. If omitted, Workers use DEFAULT_GEMINI_MODEL
# from workers/src/clients/gemini/request.ts.
SEC_FETCHER_BASE_URL=http://127.0.0.1:8789
SEC_FETCHER_SHARED_SECRET=replace-me
BACKFILL_SHARED_SECRET=replace-me
# Enable only for local wrangler dev when you intentionally want the iOS DEBUG
# header to bypass quota checks. Never set this in deployed environments.
DEBUG_UNLIMITED_ENABLED=true
# GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=12000
SEC_FETCHER_TIMEOUT_MS=25000
# Generate independent high-entropy values for local identity testing. Never
# reuse these values across environments and never commit real values.
INSTALLATION_TOKEN_HMAC_KEY_V1=replace-with-random-secret
INSTALLATION_NETWORK_HMAC_KEY_V1=replace-with-different-random-secret
ACCOUNT_PRINCIPAL_HMAC_KEY_V1=replace-with-different-random-secret
ACCOUNT_SESSION_HMAC_KEY_V1=replace-with-different-random-secret
# Public Apple application metadata required when production signed-data
# verification is exercised locally. Keep the bundle and numeric app ID paired.
APPLE_BUNDLE_ID=app.kabuyomi.ios
APPLE_APP_ID=6762764426
APP_ATTEST_TEAM_ID=UGCJZH9KG4
APP_ATTEST_BUNDLE_ID=app.kabuyomi.ios
APP_ATTEST_ALLOWED_ENVIRONMENTS=development
APP_ATTEST_ALLOWED_VALIDATION_CATEGORIES=3
APP_ATTEST_ALLOWED_BUNDLE_VERSIONS=6
APP_ATTEST_ALLOW_MISSING_APP_EXTENSIONS=true
APPLE_APP_STORE_SERVER_ENVIRONMENT=auto
# Defaults to APPLE_BUNDLE_ID when omitted for the native iOS client.
APPLE_SIGN_IN_CLIENT_ID=app.kabuyomi.ios
# Emergency gates are off when unset. Set one to true only for the bounded
# operation named by the variable.
EMERGENCY_DISABLE_SEC_REFRESH=false
EMERGENCY_DISABLE_BACKGROUND_JOBS=false
EMERGENCY_DISABLE_MIGRATIONS=false
